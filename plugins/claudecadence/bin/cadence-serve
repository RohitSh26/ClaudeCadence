#!/usr/bin/env python3
"""ClaudeCadence — start the local viewer server.

Two modes:

    cadence-serve [PROJECT_DIR]
        Serves a single project's timeline at http://localhost:<port>/
        rooted at PROJECT_DIR/.claude/cadence/.

    cadence-serve --hub
        Serves the cross-project hub at http://localhost:<port>/
        with the home page that lists every cadence + status.
        URL routes:
            /              -> home.html (the hub home page)
            /registry.json -> the per-user cadence registry
            /c/<slug>/...  -> proxies into that cadence's project dir

Port auto-detection: tries --port (default 4173), then walks +1 up to
+8 looking for a free port. The chosen port is written to
.claude/cadence/.server.port (or hub equivalent) so slash commands can
read it back.

Defaults:
    PROJECT_DIR = $CLAUDE_PROJECT_DIR or $PWD
    HUB_DIR     = ~/.claude/cadence  (override with $CLAUDECADENCE_HUB_DIR)
    PORT base   = 4173 (env $CADENCE_PORT)
    HOST        = 0.0.0.0  (so Tailscale / LAN can reach it)
"""

from __future__ import annotations

import argparse
import http.server
import json
import os
import socket
import socketserver
import sys
import threading
import time
import webbrowser
from pathlib import Path
from urllib.parse import unquote


def hub_dir() -> Path:
    return Path(os.environ.get("CLAUDECADENCE_HUB_DIR") or (Path.home() / ".claude" / "cadence"))


def find_free_port(host: str, base: int, span: int = 8) -> int | None:
    """Return the first free TCP port in [base, base+span]. None if none free."""
    for p in range(base, base + span + 1):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            try:
                s.bind((host, p))
            except OSError:
                continue
            return p
    return None


def make_hub_handler(hub_root: Path) -> type[http.server.SimpleHTTPRequestHandler]:
    """Build a handler that maps:
       /                -> hub_root/home.html (or index.html fallback)
       /registry.json   -> auto-pruned registry (drops dead project dirs);
                           augments each entry with `live` (PID alive check).
       /api/forget?slug=X (POST) -> remove a cadence from the registry.
       /c/<slug>/...    -> registry[slug].path/.claude/cadence/...
       (everything else) -> hub_root/<path>
    """
    registry_cache: dict[str, dict] = {"data": {"cadences": []}, "ts": 0.0}
    write_lock = threading.Lock()

    def load_registry() -> dict:
        reg_path = hub_root / "registry.json"
        if not reg_path.exists():
            return {"cadences": []}
        try:
            return json.loads(reg_path.read_text())
        except json.JSONDecodeError:
            return {"cadences": []}

    def save_registry(reg: dict) -> None:
        reg_path = hub_root / "registry.json"
        with write_lock:
            tmp = reg_path.with_suffix(".json.tmp")
            tmp.write_text(json.dumps(reg, indent=2))
            tmp.replace(reg_path)

    def pid_alive(pid: int) -> bool:
        if pid <= 0:
            return False
        try:
            os.kill(pid, 0)
        except (OSError, ProcessLookupError):
            return False
        return True

    def cadence_is_live(path_str: str) -> bool:
        try:
            pidfile = Path(path_str) / ".claude" / "cadence" / ".server.pid"
            if not pidfile.exists():
                return False
            return pid_alive(int(pidfile.read_text().strip()))
        except (OSError, ValueError):
            return False

    def prune_dead(reg: dict) -> tuple[dict, bool]:
        """Drop cadences whose project dir or .claude/cadence dir no longer exists.
        Returns (new_reg, was_changed)."""
        kept = []
        changed = False
        for c in reg.get("cadences", []):
            pth = c.get("path")
            if not pth:
                changed = True
                continue
            cd = Path(pth) / ".claude" / "cadence"
            if not cd.exists():
                changed = True
                continue
            kept.append(c)
        return ({"cadences": kept}, changed)

    def cadence_dir_for(slug: str) -> Path | None:
        # 1s-cached read of registry to avoid hammering the disk per request.
        now = time.monotonic()
        if now - registry_cache["ts"] > 1.0:
            registry_cache["data"] = load_registry()
            registry_cache["ts"] = now
        for c in registry_cache["data"].get("cadences", []):
            if c.get("slug") == slug:
                return Path(c["path"]) / ".claude" / "cadence"
        return None

    class HubHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=str(hub_root), **kw)

        def log_message(self, *a, **kw):
            return  # quiet

        def end_headers(self):
            # Disable browser cache so the viewer always reads fresh data.
            self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
            self.send_header("Pragma", "no-cache")
            self.send_header("Expires", "0")
            super().end_headers()

        def _send_json(self, status: int, payload: dict) -> None:
            body = json.dumps(payload).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            clean = unquote(self.path.split("?", 1)[0].split("#", 1)[0])
            if clean == "/registry.json":
                reg = load_registry()
                pruned, changed = prune_dead(reg)
                if changed:
                    save_registry(pruned)
                    registry_cache["ts"] = 0.0  # invalidate
                for c in pruned.get("cadences", []):
                    c["live"] = cadence_is_live(c.get("path", ""))
                self._send_json(200, pruned)
                return
            super().do_GET()

        def do_POST(self):
            clean = self.path.split("?", 1)[0]
            if clean == "/api/forget":
                from urllib.parse import parse_qs
                qs = parse_qs(self.path.split("?", 1)[1] if "?" in self.path else "")
                slug = (qs.get("slug") or [""])[0]
                if not slug:
                    self._send_json(400, {"error": "missing slug"})
                    return
                reg = load_registry()
                before = len(reg.get("cadences", []))
                reg["cadences"] = [c for c in reg.get("cadences", []) if c.get("slug") != slug]
                save_registry(reg)
                registry_cache["ts"] = 0.0
                self._send_json(200, {"removed": before - len(reg["cadences"]), "slug": slug})
                return
            self.send_response(404)
            self.end_headers()

        def translate_path(self, path: str) -> str:
            clean = unquote(path.split("?", 1)[0].split("#", 1)[0])
            if clean.startswith("/c/"):
                rest = clean[len("/c/"):].lstrip("/")
                if "/" not in rest:
                    rest_slug, rest_inner = rest, ""
                else:
                    rest_slug, rest_inner = rest.split("/", 1)
                if rest_slug:
                    cdir = cadence_dir_for(rest_slug)
                    if cdir is not None:
                        if not rest_inner or rest_inner.endswith("/"):
                            rest_inner = (rest_inner or "") + "index.html"
                        target = cdir / rest_inner
                        try:
                            target.resolve().relative_to(cdir.resolve())
                        except (ValueError, RuntimeError):
                            return str(hub_root / "404")
                        return str(target)
                return str(hub_root / "404")
            if clean in ("", "/"):
                return str(hub_root / "home.html")
            return super().translate_path(path)

    return HubHandler


def make_project_handler(cadence_dir: Path) -> type[http.server.SimpleHTTPRequestHandler]:
    class ProjectHandler(http.server.SimpleHTTPRequestHandler):
        def __init__(self, *a, **kw):
            super().__init__(*a, directory=str(cadence_dir), **kw)

        def log_message(self, *a, **kw):
            return

        def end_headers(self):
            # No-cache so polling sees fresh nodes.js immediately.
            self.send_header("Cache-Control", "no-store, no-cache, must-revalidate")
            self.send_header("Pragma", "no-cache")
            self.send_header("Expires", "0")
            super().end_headers()

    return ProjectHandler


def write_port_file(target_dir: Path, port: int) -> None:
    """Persist the port the server bound to so slash commands can read it back."""
    try:
        target_dir.mkdir(parents=True, exist_ok=True)
        (target_dir / ".server.port").write_text(str(port))
    except OSError:
        pass


def main() -> int:
    p = argparse.ArgumentParser(prog="cadence-serve")
    p.add_argument("project_dir", nargs="?", default=os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    p.add_argument("--hub", action="store_true", help="serve the cross-project home page instead of one project")
    p.add_argument("--port", type=int, default=int(os.environ.get("CADENCE_PORT", "4173")), help="base port (auto-walks +1 if taken)")
    p.add_argument("--host", default=os.environ.get("CADENCE_HOST", "0.0.0.0"))
    p.add_argument("--no-open", action="store_true", help="do not auto-open the browser")
    p.add_argument("--strict-port", action="store_true", help="fail if --port is taken (don't auto-walk)")
    args = p.parse_args()

    if args.hub:
        root = hub_dir()
        if not (root / "home.html").exists():
            print(
                f"[cadence-serve] {root}/home.html doesn't exist yet.\n"
                f"               Run any Claude Code session with the plugin enabled first; the hook will\n"
                f"               populate the hub directory on its first fire.",
                file=sys.stderr,
            )
            return 2
        handler_cls = make_hub_handler(root)
        target_dir = root
        label = f"hub {root}"
    else:
        cadence_dir = Path(args.project_dir) / ".claude" / "cadence"
        if not cadence_dir.exists():
            print(
                f"[cadence-serve] {cadence_dir} doesn't exist yet.\n"
                f"               Hooks haven't fired in this project. Open Claude Code and do something first.",
                file=sys.stderr,
            )
            return 2
        handler_cls = make_project_handler(cadence_dir)
        target_dir = cadence_dir
        label = f"project {cadence_dir}"

    # Pick a free port — auto-walk unless --strict-port.
    if args.strict_port:
        chosen_port = args.port
    else:
        chosen_port = find_free_port(args.host, args.port)
        if chosen_port is None:
            print(
                f"[cadence-serve] no free port in {args.port}..{args.port + 8}. "
                f"Pass --port N to pick a different base.",
                file=sys.stderr,
            )
            return 2

    try:
        class ReusableThreadingServer(socketserver.ThreadingTCPServer):
            allow_reuse_address = True
            daemon_threads = True

        with ReusableThreadingServer((args.host, chosen_port), handler_cls) as srv:
            display_host = "localhost" if args.host in ("0.0.0.0", "127.0.0.1") else args.host
            url = f"http://{display_host}:{chosen_port}/"
            write_port_file(target_dir, chosen_port)
            print(f"ClaudeCadence — serving {label}")
            print(f"  open: {url}")
            if chosen_port != args.port:
                print(f"  (port {args.port} was taken — auto-picked {chosen_port})")
            print(f"  (Ctrl-C to stop)", flush=True)
            if not args.no_open:
                threading.Thread(
                    target=lambda: (time.sleep(0.4), webbrowser.open(url)),
                    daemon=True,
                ).start()
            try:
                srv.serve_forever()
            except KeyboardInterrupt:
                print("\nStopped.")
                return 0
    except OSError as exc:
        print(f"[cadence-serve] could not bind {args.host}:{chosen_port} — {exc}", file=sys.stderr)
        return 2

    return 0


if __name__ == "__main__":
    sys.exit(main())
