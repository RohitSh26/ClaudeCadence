#!/usr/bin/env node
/**
 * ClaudeCadence — local viewer server (Node port, v1.6).
 *
 * Two modes:
 *
 *     cadence-serve [PROJECT_DIR]
 *         Serves a single project's timeline at http://localhost:<port>/
 *         rooted at PROJECT_DIR/.claude/cadence/.
 *
 *     cadence-serve --hub
 *         Serves the cross-project hub at http://localhost:<port>/
 *         with the home page that lists every cadence + status.
 *         URL routes:
 *             /                        -> home.html
 *             /registry.json           -> auto-pruned registry (drops dead
 *                                         project dirs); each entry augmented
 *                                         with `live` (PID alive check).
 *             /api/forget?slug=X (POST) -> remove a cadence from the registry
 *             /c/<slug>/...            -> proxies into that cadence's project dir
 *
 * Port auto-detection: tries --port (default 4173), then walks +1 up to
 * +8 looking for a free port. The chosen port is written to
 * .claude/cadence/.server.port so slash commands can read it back.
 *
 * Zero npm dependencies — Node built-ins only.
 */

'use strict';

const fs   = require('fs');
const path = require('path');
const http = require('http');
const net  = require('net');
const os   = require('os');
const url  = require('url');
const { exec } = require('child_process');

// ─────────────────────────── Args ────────────────────────────────────────

function parseArgs(argv) {
  const args = {
    project_dir: process.env.CLAUDE_PROJECT_DIR || process.cwd(),
    hub: false,
    port: parseInt(process.env.CADENCE_PORT || '4173', 10),
    host: process.env.CADENCE_HOST || '0.0.0.0',
    no_open: false,
    strict_port: false,
  };
  const rest = [];
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    if (a === '--hub')          args.hub = true;
    else if (a === '--no-open') args.no_open = true;
    else if (a === '--strict-port') args.strict_port = true;
    else if (a === '--port')    { args.port = parseInt(argv[++i], 10); }
    else if (a.startsWith('--port=')) { args.port = parseInt(a.slice('--port='.length), 10); }
    else if (a === '--host')    { args.host = argv[++i]; }
    else if (a.startsWith('--host=')) { args.host = a.slice('--host='.length); }
    else if (!a.startsWith('--')) rest.push(a);
  }
  if (rest.length) args.project_dir = rest[0];
  return args;
}

function hubDir() {
  return process.env.CLAUDECADENCE_HUB_DIR
    ? path.resolve(process.env.CLAUDECADENCE_HUB_DIR)
    : path.join(os.homedir(), '.claude', 'cadence');
}

// ─────────────────────────── Port handling ───────────────────────────────

function tryBind(host, port) {
  return new Promise((resolve) => {
    const srv = net.createServer();
    srv.once('error', () => resolve(false));
    srv.once('listening', () => srv.close(() => resolve(true)));
    srv.listen(port, host);
  });
}

async function findFreePort(host, base, span) {
  for (let p = base; p <= base + span; p += 1) {
    if (await tryBind(host, p)) return p;
  }
  return null;
}

function writePortFile(targetDir, port) {
  try {
    fs.mkdirSync(targetDir, { recursive: true });
    fs.writeFileSync(path.join(targetDir, '.server.port'), String(port));
  } catch (_) {}
}

// ─────────────────────────── Hub helpers ─────────────────────────────────

function isPidAlive(pid) {
  if (!pid || pid <= 0) return false;
  try { process.kill(pid, 0); return true; } catch (_) { return false; }
}

function cadenceIsLive(projectPath) {
  try {
    const pidfile = path.join(projectPath, '.claude', 'cadence', '.server.pid');
    if (!fs.existsSync(pidfile)) return false;
    const pid = parseInt(fs.readFileSync(pidfile, 'utf8').trim(), 10);
    return isPidAlive(pid);
  } catch (_) { return false; }
}

function loadRegistry(hubRoot) {
  const p = path.join(hubRoot, 'registry.json');
  if (!fs.existsSync(p)) return { cadences: [] };
  try { return JSON.parse(fs.readFileSync(p, 'utf8')); }
  catch (_) { return { cadences: [] }; }
}

function saveRegistry(hubRoot, reg) {
  const p = path.join(hubRoot, 'registry.json');
  const tmp = p + '.tmp';
  fs.writeFileSync(tmp, JSON.stringify(reg, null, 2));
  fs.renameSync(tmp, p);
}

function pruneDead(reg) {
  const kept = [];
  let changed = false;
  for (const c of (reg.cadences || [])) {
    if (!c.path) { changed = true; continue; }
    const cd = path.join(c.path, '.claude', 'cadence');
    if (!fs.existsSync(cd)) { changed = true; continue; }
    kept.push(c);
  }
  return { newReg: { ...reg, cadences: kept }, changed };
}

// ─────────────────────────── Static serving ──────────────────────────────

const MIME = {
  '.html': 'text/html; charset=utf-8',
  '.css':  'text/css; charset=utf-8',
  '.js':   'application/javascript; charset=utf-8',
  '.json': 'application/json; charset=utf-8',
  '.svg':  'image/svg+xml',
  '.png':  'image/png',
  '.jpg':  'image/jpeg',
  '.jpeg': 'image/jpeg',
  '.gif':  'image/gif',
  '.ico':  'image/x-icon',
  '.txt':  'text/plain; charset=utf-8',
  '.md':   'text/markdown; charset=utf-8',
};
function mimeFor(p) { return MIME[path.extname(p).toLowerCase()] || 'application/octet-stream'; }

function noCacheHeaders() {
  return {
    'Cache-Control': 'no-store, no-cache, must-revalidate',
    'Pragma': 'no-cache',
    'Expires': '0',
  };
}

function safeJoin(rootAbs, relUnsafe) {
  // Prevent .. escapes. Returns null if the resolved path escapes root.
  const candidate = path.resolve(rootAbs, '.' + path.posix.normalize('/' + relUnsafe));
  const rootResolved = path.resolve(rootAbs);
  if (candidate !== rootResolved && !candidate.startsWith(rootResolved + path.sep)) return null;
  return candidate;
}

function serveFile(res, fpath) {
  fs.stat(fpath, (err, st) => {
    if (err || !st.isFile()) {
      res.writeHead(404, { 'Content-Type': 'text/plain' });
      res.end('Not found');
      return;
    }
    const headers = Object.assign({
      'Content-Type': mimeFor(fpath),
      'Content-Length': st.size,
      'Last-Modified': st.mtime.toUTCString(),
    }, noCacheHeaders());
    res.writeHead(200, headers);
    fs.createReadStream(fpath).pipe(res);
  });
}

function sendJson(res, status, payload) {
  const body = Buffer.from(JSON.stringify(payload), 'utf8');
  res.writeHead(status, Object.assign({
    'Content-Type': 'application/json',
    'Content-Length': body.length,
  }, noCacheHeaders()));
  res.end(body);
}

// ─────────────────────────── Hub handler ─────────────────────────────────

function makeHubHandler(hubRoot) {
  return function (req, res) {
    const u = url.parse(req.url, true);
    const clean = decodeURIComponent(u.pathname || '/');

    // GET /registry.json — prune dead, augment with `live`.
    if (req.method === 'GET' && clean === '/registry.json') {
      const reg = loadRegistry(hubRoot);
      const { newReg, changed } = pruneDead(reg);
      if (changed) {
        try { saveRegistry(hubRoot, newReg); } catch (_) {}
      }
      for (const c of newReg.cadences) c.live = cadenceIsLive(c.path || '');
      sendJson(res, 200, newReg);
      return;
    }

    // POST /api/forget?slug=X — remove a cadence from the registry.
    if (req.method === 'POST' && clean === '/api/forget') {
      const slug = (u.query && u.query.slug) || '';
      if (!slug) { sendJson(res, 400, { error: 'missing slug' }); return; }
      const reg = loadRegistry(hubRoot);
      const before = (reg.cadences || []).length;
      reg.cadences = (reg.cadences || []).filter(c => c.slug !== slug);
      try { saveRegistry(hubRoot, reg); } catch (_) {}
      sendJson(res, 200, { removed: before - reg.cadences.length, slug });
      return;
    }

    // /c/<slug>/... — proxy into the project's .claude/cadence/.
    if (req.method === 'GET' && clean.startsWith('/c/')) {
      const rest = clean.slice('/c/'.length).replace(/^\/+/, '');
      const slashIdx = rest.indexOf('/');
      const slug    = slashIdx === -1 ? rest : rest.slice(0, slashIdx);
      let inner    = slashIdx === -1 ? '' : rest.slice(slashIdx + 1);
      if (!slug) { res.writeHead(404); res.end(); return; }
      const reg = loadRegistry(hubRoot);
      const c = (reg.cadences || []).find(x => x.slug === slug);
      if (!c) { res.writeHead(404); res.end(); return; }
      if (!inner || inner.endsWith('/')) inner = (inner || '') + 'index.html';
      const cdir = path.join(c.path, '.claude', 'cadence');
      const target = safeJoin(cdir, inner);
      if (!target) { res.writeHead(404); res.end(); return; }
      serveFile(res, target);
      return;
    }

    // Default: static file out of the hub root.
    if (req.method !== 'GET') { res.writeHead(405); res.end(); return; }
    let relPath = clean === '/' ? '/home.html' : clean;
    if (relPath.endsWith('/')) relPath += 'index.html';
    const target = safeJoin(hubRoot, relPath);
    if (!target) { res.writeHead(404); res.end(); return; }
    serveFile(res, target);
  };
}

// ─────────────────────────── Project handler ─────────────────────────────

function makeProjectHandler(cadenceDir) {
  return function (req, res) {
    if (req.method !== 'GET') { res.writeHead(405); res.end(); return; }
    const u = url.parse(req.url);
    const clean = decodeURIComponent(u.pathname || '/');

    // /api/project-name — returns the project directory name so the viewer
    // can title its header with the package, the way Claude Code does.
    if (clean === '/api/project-name') {
      const projectDir = path.dirname(path.dirname(cadenceDir));
      const body = Buffer.from(JSON.stringify({ name: path.basename(projectDir), path: projectDir }), 'utf8');
      res.writeHead(200, Object.assign({
        'Content-Type': 'application/json',
        'Content-Length': body.length,
      }, noCacheHeaders()));
      res.end(body);
      return;
    }

    // /api/hub-url — returns the running hub URL (or null) so the per-project
    // viewer can show a "all cadences" link when the user has the hub up.
    if (clean === '/api/hub-url') {
      const hub = process.env.CLAUDECADENCE_HUB_DIR
        ? path.resolve(process.env.CLAUDECADENCE_HUB_DIR)
        : path.join(os.homedir(), '.claude', 'cadence');
      const pidFile  = path.join(hub, '.server.pid');
      const portFile = path.join(hub, '.server.port');
      let hubUrl = null;
      try {
        if (fs.existsSync(pidFile) && fs.existsSync(portFile)) {
          const pid = parseInt(fs.readFileSync(pidFile, 'utf8').trim(), 10);
          if (isPidAlive(pid)) {
            const port = parseInt(fs.readFileSync(portFile, 'utf8').trim(), 10);
            if (Number.isFinite(port)) hubUrl = `http://localhost:${port}/`;
          }
        }
      } catch (_) {}
      const body = Buffer.from(JSON.stringify({ url: hubUrl }), 'utf8');
      res.writeHead(200, Object.assign({
        'Content-Type': 'application/json',
        'Content-Length': body.length,
      }, noCacheHeaders()));
      res.end(body);
      return;
    }

    let serveAt = clean;
    if (serveAt === '/' || serveAt.endsWith('/')) serveAt = (serveAt || '/') + 'index.html';
    const target = safeJoin(cadenceDir, serveAt);
    if (!target) { res.writeHead(404); res.end(); return; }
    serveFile(res, target);
  };
}

// ─────────────────────────── Main ────────────────────────────────────────

function openInBrowser(targetUrl) {
  // Best-effort cross-platform open. Failure is silent.
  let cmd;
  if (process.platform === 'darwin')      cmd = `open "${targetUrl}"`;
  else if (process.platform === 'win32')  cmd = `start "" "${targetUrl}"`;
  else                                    cmd = `xdg-open "${targetUrl}"`;
  exec(cmd, () => {});
}

async function main() {
  const args = parseArgs(process.argv.slice(2));

  let handler;
  let targetDir;
  let label;

  if (args.hub) {
    const root = hubDir();
    if (!fs.existsSync(path.join(root, 'home.html'))) {
      process.stderr.write(
        `[cadence-serve] ${root}/home.html doesn't exist yet.\n` +
        `               Run any Claude Code session with the plugin enabled first; the hook will\n` +
        `               populate the hub directory on its first fire.\n`
      );
      return 2;
    }
    handler = makeHubHandler(root);
    targetDir = root;
    label = `hub ${root}`;
  } else {
    const cadenceDir = path.join(args.project_dir, '.claude', 'cadence');
    if (!fs.existsSync(cadenceDir)) {
      process.stderr.write(
        `[cadence-serve] ${cadenceDir} doesn't exist yet.\n` +
        `               Hooks haven't fired in this project. Open Claude Code and do something first.\n`
      );
      return 2;
    }
    handler = makeProjectHandler(cadenceDir);
    targetDir = cadenceDir;
    label = `project ${cadenceDir}`;
  }

  const chosenPort = args.strict_port
    ? args.port
    : await findFreePort(args.host, args.port, 8);
  if (chosenPort === null) {
    process.stderr.write(
      `[cadence-serve] no free port in ${args.port}..${args.port + 8}. ` +
      `Pass --port N to pick a different base.\n`
    );
    return 2;
  }

  const server = http.createServer(handler);
  server.on('error', (err) => {
    process.stderr.write(`[cadence-serve] could not bind ${args.host}:${chosenPort} — ${err.message}\n`);
    process.exit(2);
  });
  server.listen(chosenPort, args.host, () => {
    const displayHost = (args.host === '0.0.0.0' || args.host === '127.0.0.1') ? 'localhost' : args.host;
    const targetUrl = `http://${displayHost}:${chosenPort}/`;
    writePortFile(targetDir, chosenPort);
    process.stdout.write(`ClaudeCadence — serving ${label}\n`);
    process.stdout.write(`  open: ${targetUrl}\n`);
    if (chosenPort !== args.port) {
      process.stdout.write(`  (port ${args.port} was taken — auto-picked ${chosenPort})\n`);
    }
    process.stdout.write(`  (Ctrl-C to stop)\n`);
    if (!args.no_open) setTimeout(() => openInBrowser(targetUrl), 400);
  });

  process.on('SIGINT',  () => { server.close(() => process.exit(0)); });
  process.on('SIGTERM', () => { server.close(() => process.exit(0)); });
  return 0;
}

main().catch((err) => {
  process.stderr.write(`[cadence-serve] fatal: ${err && err.stack || err}\n`);
  process.exit(2);
});
